# Copy this file to ~/Claude/MooveAI/keys.env (one directory above this repo
# checkout) and fill in real values. That file is outside the git repo, so
# it's never committed. KEY=VALUE, one per line, '#' for comments.

GOOGLE_MAPS_API_KEY=

# There is deliberately no key here for the Speed-Limits Quality page's
# "Custom test" box (plain-English translation/Q&A, via Gemini) - it
# authenticates via Vertex AI + Application Default Credentials, not an
# API key. Locally, run `gcloud auth application-default login` once;
# direct expressions in that box work without this either way.
